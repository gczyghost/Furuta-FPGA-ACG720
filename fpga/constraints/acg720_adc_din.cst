// Keep PEND_DO synchronizer stages together and away from the too-short edge path.
// The original unconstrained first stage at R65C138 had -0.022 ns input hold slack.
INS_LOC "dut/sensors/sensors_0/pend/spi/mi_0_s0" R[64:66]C[124:128];
INS_LOC "dut/sensors/sensors_0/pend/spi/mi_1_s0" R[64:66]C[124:128];
// Same physical hold closure for AS5048 input; do not relax its SDC budget.
INS_LOC "dut/sensors/sensors_0/asenc/spi/mi_0_s0" R[43:45]C[124:128];
INS_LOC "dut/sensors/sensors_0/asenc/spi/mi_1_s0" R[43:45]C[124:128];
// UART input hold closure: previous edge placement R58C146 gave -0.153 ns.
INS_LOC "dut/serial/receiver/sync_0_s0" R[57:59]C[116:120];
INS_LOC "dut/serial/receiver/sync_1_s0" R[57:59]C[116:120];
// ADC input hold closure: R76C32 gave -0.357 ns; retain original external timing budget.
INS_LOC "dut/sensors/sensors_0/adc/spi/rx_0_s1" R[75:77]C[88:92];
// Keep ADC output registers near left-side IO to meet the unchanged 8 ns pin budget.
INS_LOC "dut/sensors/sensors_0/adc/spi/sck_s1" R[73:77]C[2:4];
INS_LOC "dut/sensors/sensors_0/adc/spi/csn_s1" R[73:77]C[2:4];
INS_LOC "dut/sensors/sensors_0/adc/spi/mosi_s0" R75C2;

// Boundary candidate: move UART synchronizers inward for -0.013 ns hold failure;
// ADC output flops move nearer left IO for -0.174 ns max-delay failure.
// External timing budgets remain unchanged.

// ACG720 main-board S0..S4, schematic pages 2/10; no P7 alias.
IO_LOC "KEY_N[0]" F15;
IO_PORT "KEY_N[0]" IO_TYPE=LVCMOS33;
IO_LOC "KEY_N[1]" A20;
IO_PORT "KEY_N[1]" IO_TYPE=LVCMOS33;
IO_LOC "KEY_N[2]" B20;
IO_PORT "KEY_N[2]" IO_TYPE=LVCMOS33;
