IO_PORT "ADC_SCLK" IO_TYPE=LVCMOS33;
IO_LOC "CLK_50M" Y18;
IO_PORT "CLK_50M" IO_TYPE=LVCMOS33;
IO_LOC "UART_RX" J21;
IO_PORT "UART_RX" IO_TYPE=LVCMOS33;
